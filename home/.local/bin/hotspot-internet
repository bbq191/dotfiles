#!/usr/bin/env bash
# 热点（共享 Wi-Fi「大郎少喝点」）翻墙开关：
# on  = 热点设备走 mihomo 完整分流，可翻墙；
# off = 热点设备强制 DIRECT（经有线直连出去），国内可用、被墙的不通——不断网。
#
# 原理：mihomo rules 置顶有一条 `RULE-SET,hotspot_direct,DIRECT`，实际逻辑在
# mihomo-direct-switch（改写 flag 文件 + 调 API 刷新 provider + 断存量连接）。
# 无需 root；状态在 flag 文件里，重启后保持。DMS 插件 hotspotInternet 只调用
# toggle，用 FileView 直接监听 flag 文件显示状态，不解析这里的输出。
set -euo pipefail
exec "$HOME/.local/bin/mihomo-direct-switch" \
    /etc/mihomo/flags/hotspot-direct.yaml hotspot_direct 10.42.0.0/24 10.42. "热点设备" \
    "${1:-status}"
