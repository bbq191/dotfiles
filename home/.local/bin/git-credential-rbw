#!/usr/bin/env bash
case "$1" in
    get)
        while IFS= read -r line && [[ -n "$line" ]]; do
            key="${line%%=*}"
            value="${line#*=}"
            declare "$key=$value"
        done

        bare_host="${host%%:*}"

        raw=$(rbw get --raw "$bare_host" 2>/dev/null) || exit 0
        # Skip SSH Key type entries (they have private_key, not password)
        if printf '%s' "$raw" | python3 -c "import json,sys; exit(0 if 'private_key' in json.load(sys.stdin).get('data',{}) else 1)" 2>/dev/null; then
            exit 0
        fi
        password=$(rbw get "$bare_host" 2>/dev/null) || exit 0
        username=$(rbw get --field username "$bare_host" 2>/dev/null) || true

        [[ -n "$username" ]] && printf 'username=%s\n' "$username"
        printf 'password=%s\n' "$password"
        ;;
    store|erase)
        ;;
esac
