#!/usr/bin/env bash
# 备份 ~/Documents 和 ~/Projects 到外接盘上的 restic 仓库（排除可重建的构建产物/
# 依赖缓存，见 ~/.config/restic/excludes.txt）。按需手动运行：插上外接盘后执行。
# 不做成定时任务——外接盘不会一直插着，盘不在时定时任务只会白白失败，不如手动跑；
# 成功后会记一个时间戳，backup-reminder（用户级 timer，每天）超过 14 天没备份就弹桌面通知。
#
# 密码存 Bitwarden（`rbw add restic-repo-password`，首次用前必须先加好），
# 外接盘换了要改下面的 DRIVE_UUID（`lsblk -o NAME,UUID,LABEL` 查新盘的 UUID）。
set -euo pipefail

DRIVE_UUID=B22B-FFC4  # Kingston DataTraveler USB 盘（exFAT，卷标 afu）
REPO_SUBDIR=restic-repo  # 仓库放在盘的子目录下，盘上还有其他既有文件，不用盘根目录

mountpoint=$(findmnt -no TARGET UUID="$DRIVE_UUID" 2>/dev/null || true)
if [[ -z "$mountpoint" ]]; then
    echo "[+] 挂载外接盘..."
    udisksctl mount -b "/dev/disk/by-uuid/$DRIVE_UUID"
    mountpoint=$(findmnt -no TARGET UUID="$DRIVE_UUID")
fi

export RESTIC_REPOSITORY="$mountpoint/$REPO_SUBDIR"
export RESTIC_PASSWORD_COMMAND="rbw get restic-repo-password"

if [[ ! -f "$RESTIC_REPOSITORY/config" ]]; then
    echo "[+] 仓库不存在，初始化: $RESTIC_REPOSITORY"
    restic init
fi

echo "[+] 备份 ~/Documents ~/Projects..."
restic backup "$HOME/Documents" "$HOME/Projects" \
    --exclude-file "$HOME/.config/restic/excludes.txt" \
    --exclude-caches \
    --skip-if-unchanged

echo "[+] 清理旧快照（保留最近 5 份 + 每周 4 份 + 每月 6 份）..."
restic forget --keep-last 5 --keep-weekly 4 --keep-monthly 6 --prune

# 成功时间戳供 backup-reminder 判断；放在 forget 之后，整套流程都跑完才算一次成功备份
STAMP_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/backup-home"
mkdir -p "$STAMP_DIR"
touch "$STAMP_DIR/last-success"

restic snapshots
