#!/usr/bin/env bash
# USB 直连设备（10.11.99.1，imx93 类）经本机 mihomo 上外网的开关。
#
# on : 启动 remarkable-usb-share.timer（45s 自愈推送）并立即推送一次;
# off: 停止 timer，并在设备在线时 SSH 撤销 usb1 的网关路由 + 链路级 DNS，
#      设备路由回落到自身 Wi-Fi（Wi-Fi 连接全程不受影响）。
#      全局 DoT 兜底配置保留——那是修设备自身 Wi-Fi 的 53 端口黑洞的，与共享无关。
#
# timer 是 enabled 的用户单元，重启后自动拉起 => 默认开启。
# 已知边角：off 时设备若挂起（SSH 冻结）则无法撤销，设备醒后仍暂有外网；
# 再执行一次 off 或等设备重启（/etc 为易失 overlay）即可清除。
set -euo pipefail

DEV=10.11.99.1
TIMER=remarkable-usb-share.timer

sharing_on() { systemctl --user --quiet is-active "$TIMER"; }

revert_device() {
    ping -c1 -W1 "$DEV" >/dev/null 2>&1 || return 0
    ssh -o BatchMode=yes -o ConnectTimeout=3 "root@$DEV" '
        rm -f /etc/systemd/network/10-usb.network.d/pc-gateway.conf
        networkctl reload
        networkctl reconfigure usb1
        logger -t remarkable-usb-share "deprovisioned by PC switch"
    ' 2>/dev/null || echo "警告: 设备在线但撤销配置失败（SSH）" >&2
}

case "${1:-status}" in
    on)
        systemctl --user start "$TIMER"
        systemctl --user start remarkable-usb-share.service
        ;;
    off)
        systemctl --user stop "$TIMER"
        revert_device
        ;;
    toggle)
        if sharing_on; then exec "$0" off; else exec "$0" on; fi
        ;;
    status) ;;
    *)
        echo "用法: ${0##*/} [on|off|toggle|status]" >&2
        exit 2
        ;;
esac

if sharing_on; then
    echo "on — USB 设备经 mihomo 上外网（timer 自动推送）"
else
    echo "off — USB 共享已停止"
fi
