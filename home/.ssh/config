Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
    ControlMaster auto
    ControlPath ~/.cache/ssh/%C
    ControlPersist 10m

# 旧设备仅支持 ssh-rsa，显式降级以维持连接
Host 40.10.1.53
    HostKeyAlgorithms +ssh-rsa
    PubkeyAcceptedKeyTypes +ssh-rsa

# vksight.com 博客服务器（RackNerd LAX DC03，22 端口被机房过滤，固定用 2222）
# 2026-09-16 起改用非 root 的 afu 账户登录（sudo NOPASSWD），root 直登已在服务端禁用。
Host vksight
    HostName 192.236.234.220
    Port 2222
    User afu

# 宝塔面板隧道：公网 9889 已在 ufw 关闭，只能经 SSH 转发访问。
# 用法：ssh -N vksight-panel，然后浏览器开 https://127.0.0.1:9889/vksight（自签证书警告属正常）
# 单独起连接、不复用 vksight 的 ControlMaster，避免转发绑在别的会话上、关掉就断。
Host vksight-panel
    HostName 192.236.234.220
    Port 2222
    User afu
    LocalForward 9889 127.0.0.1:9889
    ExitOnForwardFailure yes
    ControlMaster no
    ControlPath none
