# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#fff8f5"
set default-fg "#201a17"

set statusbar-bg "#f7ece5"
set statusbar-fg "#201a17"
set inputbar-bg "#f7ece5"
set inputbar-fg "#201a17"

set completion-bg "#f7ece5"
set completion-fg "#201a17"
set completion-group-bg "#f2e6e0"
set completion-group-fg "#462100"
set completion-highlight-bg "#462100"
set completion-highlight-fg "#ffffff"

set index-bg "#fff8f5"
set index-fg "#201a17"
set index-active-bg "#462100"
set index-active-fg "#ffffff"

set highlight-color "rgba(70, 33, 0, 0.35)"
set highlight-active-color "rgba(44, 45, 0, 0.45)"

set notification-bg "#f7ece5"
set notification-fg "#201a17"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#2c2d00"
set notification-warning-fg "#ffffff"

set render-loading-bg "#fff8f5"
set render-loading-fg "#201a17"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#fff8f5"
set recolor-darkcolor "#201a17"
