# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#17120f"
set default-fg "#ece0da"

set statusbar-bg "#241e1b"
set statusbar-fg "#ece0da"
set inputbar-bg "#241e1b"
set inputbar-fg "#ece0da"

set completion-bg "#241e1b"
set completion-fg "#ece0da"
set completion-group-bg "#2f2925"
set completion-group-fg "#fbb886"
set completion-highlight-bg "#fbb886"
set completion-highlight-fg "#4e2600"

set index-bg "#17120f"
set index-fg "#ece0da"
set index-active-bg "#fbb886"
set index-active-fg "#4e2600"

set highlight-color "rgba(251, 184, 134, 0.35)"
set highlight-active-color "rgba(201, 203, 130, 0.45)"

set notification-bg "#241e1b"
set notification-fg "#ece0da"
set notification-error-bg "#ffb4ab"
set notification-error-fg "#690005"
set notification-warning-bg "#c9cb82"
set notification-warning-fg "#313300"

set render-loading-bg "#17120f"
set render-loading-fg "#ece0da"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#17120f"
set recolor-darkcolor "#ece0da"
