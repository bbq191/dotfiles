# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#f8f9fb"
set default-fg "#191c1e"

set statusbar-bg "#eceef0"
set statusbar-fg "#191c1e"
set inputbar-bg "#eceef0"
set inputbar-fg "#191c1e"

set completion-bg "#eceef0"
set completion-fg "#191c1e"
set completion-group-bg "#e6e8ea"
set completion-group-fg "#13667f"
set completion-highlight-bg "#13667f"
set completion-highlight-fg "#ffffff"

set index-bg "#f8f9fb"
set index-fg "#191c1e"
set index-active-bg "#13667f"
set index-active-fg "#ffffff"

set highlight-color "rgba(19, 102, 127, 0.35)"
set highlight-active-color "rgba(117, 81, 131, 0.45)"

set notification-bg "#eceef0"
set notification-fg "#191c1e"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#755183"
set notification-warning-fg "#ffffff"

set render-loading-bg "#f8f9fb"
set render-loading-fg "#191c1e"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#f8f9fb"
set recolor-darkcolor "#191c1e"
