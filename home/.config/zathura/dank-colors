# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#fbf9fb"
set default-fg "#1b1c1d"

set statusbar-bg "#efedef"
set statusbar-fg "#1b1c1d"
set inputbar-bg "#efedef"
set inputbar-fg "#1b1c1d"

set completion-bg "#efedef"
set completion-fg "#1b1c1d"
set completion-group-bg "#e9e7ea"
set completion-group-fg "#0c2237"
set completion-highlight-bg "#0c2237"
set completion-highlight-fg "#ffffff"

set index-bg "#fbf9fb"
set index-fg "#1b1c1d"
set index-active-bg "#0c2237"
set index-active-fg "#ffffff"

set highlight-color "rgba(12, 34, 55, 0.35)"
set highlight-active-color "rgba(46, 25, 48, 0.45)"

set notification-bg "#efedef"
set notification-fg "#1b1c1d"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#2e1930"
set notification-warning-fg "#ffffff"

set render-loading-bg "#fbf9fb"
set render-loading-fg "#1b1c1d"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#fbf9fb"
set recolor-darkcolor "#1b1c1d"
