# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#f6fafe"
set default-fg "#171c1f"

set statusbar-bg "#eaeef2"
set statusbar-fg "#171c1f"
set inputbar-bg "#eaeef2"
set inputbar-fg "#171c1f"

set completion-bg "#eaeef2"
set completion-fg "#171c1f"
set completion-group-bg "#e4e9ed"
set completion-group-fg "#006687"
set completion-highlight-bg "#006687"
set completion-highlight-fg "#ffffff"

set index-bg "#f6fafe"
set index-fg "#171c1f"
set index-active-bg "#006687"
set index-active-fg "#ffffff"

set highlight-color "rgba(0, 102, 135, 0.35)"
set highlight-active-color "rgba(125, 72, 152, 0.45)"

set notification-bg "#eaeef2"
set notification-fg "#171c1f"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#7d4898"
set notification-warning-fg "#ffffff"

set render-loading-bg "#f6fafe"
set render-loading-fg "#171c1f"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#f6fafe"
set recolor-darkcolor "#171c1f"
