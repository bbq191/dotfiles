# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#111318"
set default-fg "#e2e2e9"

set statusbar-bg "#1e1f25"
set statusbar-fg "#e2e2e9"
set inputbar-bg "#1e1f25"
set inputbar-fg "#e2e2e9"

set completion-bg "#1e1f25"
set completion-fg "#e2e2e9"
set completion-group-bg "#282a2f"
set completion-group-fg "#aec6ff"
set completion-highlight-bg "#aec6ff"
set completion-highlight-fg "#112f60"

set index-bg "#111318"
set index-fg "#e2e2e9"
set index-active-bg "#aec6ff"
set index-active-fg "#112f60"

set highlight-color "rgba(174, 198, 255, 0.35)"
set highlight-active-color "rgba(222, 188, 223, 0.45)"

set notification-bg "#1e1f25"
set notification-fg "#e2e2e9"
set notification-error-bg "#ffb4ab"
set notification-error-fg "#690005"
set notification-warning-bg "#debcdf"
set notification-warning-fg "#402843"

set render-loading-bg "#111318"
set render-loading-fg "#e2e2e9"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#111318"
set recolor-darkcolor "#e2e2e9"
