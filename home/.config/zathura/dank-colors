# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#faf9fd"
set default-fg "#1a1c1f"

set statusbar-bg "#eeedf2"
set statusbar-fg "#1a1c1f"
set inputbar-bg "#eeedf2"
set inputbar-fg "#1a1c1f"

set completion-bg "#eeedf2"
set completion-fg "#1a1c1f"
set completion-group-bg "#e8e8ec"
set completion-group-fg "#3d5d8b"
set completion-highlight-bg "#3d5d8b"
set completion-highlight-fg "#ffffff"

set index-bg "#faf9fd"
set index-fg "#1a1c1f"
set index-active-bg "#3d5d8b"
set index-active-fg "#ffffff"

set highlight-color "rgba(61, 93, 139, 0.35)"
set highlight-active-color "rgba(120, 77, 123, 0.45)"

set notification-bg "#eeedf2"
set notification-fg "#1a1c1f"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#784d7b"
set notification-warning-fg "#ffffff"

set render-loading-bg "#faf9fd"
set render-loading-fg "#1a1c1f"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#faf9fd"
set recolor-darkcolor "#1a1c1f"
