# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#fbf9fa"
set default-fg "#1b1b1d"

set statusbar-bg "#f0edee"
set statusbar-fg "#1b1b1d"
set inputbar-bg "#f0edee"
set inputbar-fg "#1b1b1d"

set completion-bg "#f0edee"
set completion-fg "#1b1b1d"
set completion-group-bg "#eae7e9"
set completion-group-fg "#535f70"
set completion-highlight-bg "#535f70"
set completion-highlight-fg "#ffffff"

set index-bg "#fbf9fa"
set index-fg "#1b1b1d"
set index-active-bg "#535f70"
set index-active-fg "#ffffff"

set highlight-color "rgba(83, 95, 112, 0.35)"
set highlight-active-color "rgba(107, 88, 107, 0.45)"

set notification-bg "#f0edee"
set notification-fg "#1b1b1d"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#6b586b"
set notification-warning-fg "#ffffff"

set render-loading-bg "#fbf9fa"
set render-loading-fg "#1b1b1d"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#fbf9fa"
set recolor-darkcolor "#1b1b1d"
