# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#fff8f7"
set default-fg "#271818"

set statusbar-bg "#ffe9e8"
set statusbar-fg "#271818"
set inputbar-bg "#ffe9e8"
set inputbar-fg "#271818"

set completion-bg "#ffe9e8"
set completion-fg "#271818"
set completion-group-bg "#fee2e1"
set completion-group-fg "#b21533"
set completion-highlight-bg "#b21533"
set completion-highlight-fg "#ffffff"

set index-bg "#fff8f7"
set index-fg "#271818"
set index-active-bg "#b21533"
set index-active-fg "#ffffff"

set highlight-color "rgba(178, 21, 51, 0.35)"
set highlight-active-color "rgba(141, 72, 0, 0.45)"

set notification-bg "#ffe9e8"
set notification-fg "#271818"
set notification-error-bg "#ba1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#8d4800"
set notification-warning-fg "#ffffff"

set render-loading-bg "#fff8f7"
set render-loading-fg "#271818"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#fff8f7"
set recolor-darkcolor "#271818"
