# zathura 配色 — matugen 模板（.default = 跟随 DMS 明暗模式）
set default-bg "#101415"
set default-fg "#e0e3e5"

set statusbar-bg "#1d2022"
set statusbar-fg "#e0e3e5"
set inputbar-bg "#1d2022"
set inputbar-fg "#e0e3e5"

set completion-bg "#1d2022"
set completion-fg "#e0e3e5"
set completion-group-bg "#272a2c"
set completion-group-fg "#8bd0ec"
set completion-highlight-bg "#8bd0ec"
set completion-highlight-fg "#003544"

set index-bg "#101415"
set index-fg "#e0e3e5"
set index-active-bg "#8bd0ec"
set index-active-fg "#003544"

set highlight-color "rgba(139, 208, 236, 0.35)"
set highlight-active-color "rgba(227, 183, 241, 0.45)"

set notification-bg "#1d2022"
set notification-fg "#e0e3e5"
set notification-error-bg "#ffb4ab"
set notification-error-fg "#690005"
set notification-warning-bg "#e3b7f1"
set notification-warning-fg "#432352"

set render-loading-bg "#101415"
set render-loading-fg "#e0e3e5"

# 重染色板：暗色模式下 Ctrl+R 把页面染成 主题背景/前景
set recolor-lightcolor "#101415"
set recolor-darkcolor "#e0e3e5"
