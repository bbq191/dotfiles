{
  "window.density.editorTabHeight": "compact",
  "window.menuBarVisibility": "visible",
  "window.restoreWindows": "none",

  // =============================================
  // 工作区布局设置
  // =============================================
  "workbench.activityBar.location": "bottom",
  "workbench.iconTheme": "vscode-icons",
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.wrapTabs": true,
  "workbench.navigationControl.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.tips.enabled": false,
  "workbench.panel.showLabels": false,

  // =============================================
  // 编辑器核心设置
  // =============================================
  "editor.fontFamily": "'Maple Mono NF CN'",
  "editor.fontSize": 13,
  "editor.cursorStyle": "block",
  "editor.cursorBlinking": "solid",
  "editor.lineNumbers": "relative",
  "editor.detectIndentation": false,
  "editor.dragAndDrop": false,
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "all",
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeLens": true,

  // 编辑器格式化设置
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.organizeImports": "always",
  },

  // 编辑器多语言支持
  "editor.unicodeHighlight.allowedLocales": {
    "zh-hans": true,
  },

  // IME 输入法优化配置
  "editor.suggest.localityBonus": true,
  "editor.acceptSuggestionOnCommitCharacter": false,

  // =============================================
  // 文件和搜索设置
  // =============================================
  "files.trimTrailingWhitespace": true,
  "files.associations": {
    "*.template": "shellscript",
    "enhanced_bashrc": "shellscript",
  },
  "search.followSymlinks": false,
  "redhat.telemetry.enabled": false,

  // 资源管理器设置
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,

  // 面包屑导航
  "breadcrumbs.enabled": false,

  // =============================================
  // 终端配置
  // =============================================
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.scrollback": 50000,
  "terminal.integrated.fastScrollSensitivity": 5,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.windowsEnableConpty": false,
  "terminal.integrated.gpuAcceleration": "on",
  // 终端配置文件
  "terminal.integrated.profiles.windows": {
    "PowerShell 7": {
      "path": "F:/dev-tools/powershell/7/pwsh.exe",
      "icon": "terminal-powershell",
      "args": ["-NoLogo"],
    },
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell 7",
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  // =============================================
  // Neovim 集成配置
  // =============================================
  "vscode-neovim.neovimExecutablePaths.win32": "nvim",
  "vscode-neovim.ctrlKeysForInsertMode": ["b", "d", "h", "j", "k", "l"],
  "vscode-neovim.ctrlKeysForNormalMode": ["b", "d", "h", "j", "k", "l", "v"],

  // 自定义组合键设置
  "vscode-neovim.compositeKeys": {
    "jj": {
      "command": "vscode-neovim.lua",
      "args": [
        [
          "local code = require('vscode')",
          "code.action('vscode-neovim.escape')",
          "code.action('workbench.action.files.save')",
        ],
      ],
    },
  },

  // =============================================
  // Git 版本控制设置
  // =============================================
  "git.autoStash": true,
  "git.autofetch": false,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",

  // =============================================
  // 调试和开发工具
  // =============================================
  "errorLens.fontStyleItalic": true,
  "errorLens.gutterIconSet": "emoji",
  "errorLens.gutterIconSize": "80%",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.gutterEmoji": {
    "error": "E",
    "warning": "W",
    "info": "I",
    "hint": "H",
  },
  "debug.openDebug": "neverOpen",

  // =============================================
  // 安全和隐私设置
  // =============================================
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.enabled": false,
  "security.workspace.trust.startupPrompt": "never",
  "security.workspace.trust.untrustedFiles": "open",

  // =============================================
  // 扩展和更新管理
  // =============================================
  "extensions.ignoreRecommendations": true,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "update.showReleaseNotes": false,

  // AI 聊天功能
  "chat.commandCenter.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.selectedModel": "default",

  // =============================================
  // 专注模式设置
  // =============================================
  "zenMode.fullScreen": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": false,
  "chat.tools.terminal.outputLocation": "chat",
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
  },
  "prisma.hidePrisma6Prompts": true,
  "workbench.sideBar.location": "right",
  "vsicons.dontShowNewVersionMessage": true,
  "js/ts.experimental.useTsgo": true,

  // =============================================
  // 集成终端配色 — 对齐 kitty Tokyo Night
  // =============================================
  "workbench.colorCustomizations": {
    "terminal.background": "#1a1b26",
    "terminal.foreground": "#c0caf5",
    "terminal.selectionBackground": "#283457",
    "terminal.ansiBlack": "#15161e",
    "terminal.ansiRed": "#f7768e",
    "terminal.ansiGreen": "#9ece6a",
    "terminal.ansiYellow": "#e0af68",
    "terminal.ansiBlue": "#7aa2f7",
    "terminal.ansiMagenta": "#bb9af7",
    "terminal.ansiCyan": "#7dcfff",
    "terminal.ansiWhite": "#a9b1d6",
    "terminal.ansiBrightBlack": "#414868",
    "terminal.ansiBrightRed": "#f7768e",
    "terminal.ansiBrightGreen": "#9ece6a",
    "terminal.ansiBrightYellow": "#e0af68",
    "terminal.ansiBrightBlue": "#7aa2f7",
    "terminal.ansiBrightMagenta": "#bb9af7",
    "terminal.ansiBrightCyan": "#7dcfff",
    "terminal.ansiBrightWhite": "#c0caf5",
  },
}
