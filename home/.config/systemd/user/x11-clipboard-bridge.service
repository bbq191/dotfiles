[Unit]
Description=X11 <-> Wayland text clipboard bridge (xwayland-satellite 0.8.2 bridge gets stuck, upstream #485)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/x11-clipboard-bridge
# satellite 被杀/重启时 X 连接断开进程退出，靠这里自动重连
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
